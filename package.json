{
  "name": "hereafter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:pages": "npm run typecheck && vite build --mode pages",
    "preview": "vite preview",
    "preview:pages": "vite preview --mode pages",
    "build:viewmodels": "sh scripts/viewmodels/build-all.sh",
    "build:audio": "sh scripts/audio/fetch.sh && sh scripts/audio/build.sh",
    "build:props": "sh scripts/props/build.sh",
    "build:lightmaps": "sh scripts/lightmaps/build.sh",
    "build:truck": "sh scripts/truck/build.sh"
  },
  "dependencies": {
    "@dimforge/rapier3d": "^0.21.0",
    "three": "^0.186.1",
    "trystero": "^0.26.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
