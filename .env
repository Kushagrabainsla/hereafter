# Authored first-person view models bundled from public/models (see docs/rendering.md).
# Remove a line to fall back to the procedural hands for that weapon.
VITE_KNIFE_VIEWMODEL=models/knife.glb
VITE_PISTOL_VIEWMODEL=models/pistol.glb
VITE_RIFLE_VIEWMODEL=models/rifle.glb
# Third-person character for other players; remove to use the primitive mannequins.
VITE_PLAYER_MODEL=models/player.glb
